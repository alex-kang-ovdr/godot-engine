; Standalone Animation Studio demo and headless regression fixtures.
config_version=5

[application]
config/name="Animation Studio — Motion Lab"
run/main_scene="res://demo/animation_lab.tscn"
run/flush_stdout_on_print=true

[display]
window/size/viewport_width=1152
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[physics]
common/physics_ticks_per_second=60

[playforge]
avatar/world_binding="attach_player_character"

[rendering]
renderer/rendering_method="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
